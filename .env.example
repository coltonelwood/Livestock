# ─────────────────────────────────────────────────────────────────────────────
# OpenRange environment contract.
# Copy to `.env.local` and fill in. NEVER commit real values.
# Only NEXT_PUBLIC_* vars are exposed to the browser. Everything else is
# server-only and must never be prefixed with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — use ONLY in trusted server code (admin, webhooks).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude (powers the Lead Assistant chat). If unset, the Lead
# Assistant degrades to a canned reply instead of crashing.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optional override; defaults to a current Claude model in code.
ANTHROPIC_MODEL=claude-sonnet-4-6

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for the auction auto-close cron route (/api/auctions/close-due).
# Point a Vercel Cron at that route with header: Authorization: Bearer <secret>.
# If unset, the route is disabled (fail closed).
CRON_SECRET=

# Email notifications (Resend). If unset, notifications are still recorded in
# the database (status "skipped") but no email is sent.
RESEND_API_KEY=
NOTIFICATIONS_FROM="OpenRange <onboarding@resend.dev>"

# Upstash Redis — durable rate limiting for public endpoints (chat, inquiry,
# contact). Server-only. Create a database at https://console.upstash.com and
# copy the REST URL + token.
#
# REQUIRED FOR PRODUCTION. If unset, the limiter is unavailable and:
#   - anonymous AI chat FAILS CLOSED (denied) to protect model-token spend;
#   - non-AI public forms (listing inquiry, marketing contact) FAIL OPEN so real
#     leads are never silently dropped — which means they have NO abuse
#     protection until this is configured. Set these before launch.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Stripe billing (subscriptions) ──
# Server-only secret + webhook signing secret. If unset, billing is disabled
# and orgs run on the free tier.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs for each plan (create products/prices in the Stripe dashboard).
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ── Phase 1 placeholders (architecture present, not wired to live services) ──
# Telephony (Twilio or Telnyx)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
