# ─────────────────────────────────────────────────────────────────────────────
# OpenRange environment contract.
# Copy to `.env.local` and fill in. NEVER commit real values.
# Only NEXT_PUBLIC_* vars are exposed to the browser. Everything else is
# server-only and must never be prefixed with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — use ONLY in trusted server code (admin, webhooks).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude (AI receptionist)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optional override; defaults to a current Claude model in code.
ANTHROPIC_MODEL=claude-sonnet-4-6

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstash Redis — durable rate limiting for public endpoints (chat, inquiry,
# contact). Server-only. If unset, public AI endpoints FAIL CLOSED (deny) while
# the authenticated dashboard test panel fails open. Create a database at
# https://console.upstash.com and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Phase 1 placeholders (architecture present, not wired to live services) ──
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Telephony (Twilio or Telnyx)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
